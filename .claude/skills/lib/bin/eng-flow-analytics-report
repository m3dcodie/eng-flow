#!/usr/bin/env python3
"""
eng-flow analytics: rollup report.

Reads eng-flow/analytics.jsonl (written incrementally by
eng-flow-analytics-checkpoint/-finish across every stage) and prints a
per-story and per-skill summary: wall-clock time and token usage broken
down by category (input / output / cache-creation / cache-read -- these
cost very differently, so they're kept separate, not flattened into one
number). No dollar estimate -- pricing changes and isn't this script's
job to track; report raw tokens.

Also reports, derived from the same rows without any new instrumentation:
  - cycle time: elapsed (calendar, min ts_start to max ts_end) vs. active
    (summed duration_s) time per story -- the gap between them is idle/
    handoff time sitting between sessions or stages.
  - stage-transition gaps: the idle time between one skill's last ts_end
    and the next distinct skill's first ts_start, in story order.
  - rework cycles: distinct run_ids per (story, skill) -- run_id resets
    on each fresh invocation, so >1 for eng-flow-code-review/eng-flow-qa
    means the story went through a re-review/re-QA loop.

And, if eng-flow/findings.jsonl exists (written by eng-flow-findings-log
at the end of eng-flow-code-review/eng-flow-qa): a bug-rate rollup --
Critical/Required/Nit finding counts per story and project-wide.

Usage: eng-flow-analytics-report [story-slug]
"""
import json
import os
import sys
from datetime import datetime


def load_rows(path):
    rows = []
    if not os.path.isfile(path):
        return rows
    with open(path, "r", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return rows


def empty_usage():
    return {
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_creation_input_tokens": 0,
        "cache_read_input_tokens": 0,
    }


def add_usage(totals, usage):
    if not usage:
        return
    for k in totals:
        totals[k] += usage.get(k, 0) or 0


def fmt_duration(seconds):
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    if h:
        return f"{h}h{m}m"
    if m:
        return f"{m}m{s}s"
    return f"{s}s"


def fmt_tokens(n):
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n/1_000:.1f}k"
    return str(n)


def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError:
        return None


def fmt_span(start, end):
    if not start or not end:
        return "?"
    return fmt_duration((end - start).total_seconds())


def load_findings(path):
    rows = []
    if not os.path.isfile(path):
        return rows
    with open(path, "r", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return rows


def main():
    root = os.getcwd()
    log_path = os.path.join(root, "eng-flow", "analytics.jsonl")
    findings_path = os.path.join(root, "eng-flow", "findings.jsonl")
    filter_story = sys.argv[1] if len(sys.argv) > 1 else None

    rows = load_rows(log_path)
    if not rows:
        print("No analytics data yet (eng-flow/analytics.jsonl is empty or missing).")
        return 0

    if filter_story:
        rows = [r for r in rows if r.get("story") == filter_story]
        if not rows:
            print(f"No analytics data for story '{filter_story}'.")
            return 0

    by_story = {}
    by_skill = {}
    recovered_count = 0
    # story -> skill -> {"first_start": dt, "last_end": dt, "run_ids": set()}
    story_skill_spans = {}

    for r in rows:
        story = r.get("story") or "(no story)"
        skill = r.get("skill") or "(unknown skill)"
        dur = r.get("duration_s", 0) or 0
        usage = r.get("usage")
        if r.get("outcome") == "recovered":
            recovered_count += 1

        s = by_story.setdefault(story, {"duration_s": 0, "usage": empty_usage(), "steps": 0})
        s["duration_s"] += dur
        s["steps"] += 1
        add_usage(s["usage"], usage)

        k = by_skill.setdefault(skill, {"duration_s": 0, "usage": empty_usage(), "steps": 0})
        k["duration_s"] += dur
        k["steps"] += 1
        add_usage(k["usage"], usage)

        start, end = parse_iso(r.get("ts_start")), parse_iso(r.get("ts_end"))
        if start and end:
            sk = story_skill_spans.setdefault(story, {}).setdefault(
                skill, {"first_start": start, "last_end": end, "run_ids": set()}
            )
            sk["first_start"] = min(sk["first_start"], start)
            sk["last_end"] = max(sk["last_end"], end)
            if r.get("run_id"):
                sk["run_ids"].add(r["run_id"])

    def print_usage_line(label, data):
        u = data["usage"]
        total_tokens = sum(u.values())
        print(
            f"  {label:<32} {fmt_duration(data['duration_s']):>8}  "
            f"steps={data['steps']:<4} "
            f"in={fmt_tokens(u['input_tokens'])} out={fmt_tokens(u['output_tokens'])} "
            f"cache-w={fmt_tokens(u['cache_creation_input_tokens'])} "
            f"cache-r={fmt_tokens(u['cache_read_input_tokens'])} "
            f"(total={fmt_tokens(total_tokens)})"
        )

    print("=== By story ===")
    for story, data in sorted(by_story.items(), key=lambda kv: -kv[1]["duration_s"]):
        print_usage_line(story, data)

    print()
    print("=== By skill/stage ===")
    for skill, data in sorted(by_skill.items(), key=lambda kv: -kv[1]["duration_s"]):
        print_usage_line(skill, data)

    print()
    print("=== Cycle time (elapsed vs. active) ===")
    for story, skill_spans in story_skill_spans.items():
        story_start = min(v["first_start"] for v in skill_spans.values())
        story_end = max(v["last_end"] for v in skill_spans.values())
        active = by_story[story]["duration_s"]
        print(
            f"  {story:<32} elapsed={fmt_span(story_start, story_end):>8}  "
            f"active={fmt_duration(active):>8}"
        )

        ordered = sorted(skill_spans.items(), key=lambda kv: kv[1]["first_start"])
        for i in range(1, len(ordered)):
            prev_skill, prev = ordered[i - 1]
            skill, cur = ordered[i]
            gap = (cur["first_start"] - prev["last_end"]).total_seconds()
            if gap > 0:
                print(f"      gap {prev_skill} -> {skill}: {fmt_duration(gap)}")

        for skill, v in ordered:
            if skill in ("eng-flow-code-review", "eng-flow-qa") and len(v["run_ids"]) > 1:
                print(f"      {skill}: {len(v['run_ids'])} passes (rework/re-review loop)")

    findings_rows = load_findings(findings_path)
    if filter_story:
        findings_rows = [r for r in findings_rows if r.get("story") == filter_story]
    if findings_rows:
        print()
        print("=== Bug rate (from findings.jsonl) ===")
        by_story_findings = {}
        totals = {"Critical": 0, "Required": 0, "Nit": 0}
        for r in findings_rows:
            story = r.get("story") or "(no story)"
            counts = r.get("counts") or {}
            entry = by_story_findings.setdefault(
                story, {"Critical": 0, "Required": 0, "Nit": 0, "passes": 0}
            )
            entry["passes"] += 1
            for sev in ("Critical", "Required", "Nit"):
                n = counts.get(sev, 0) or 0
                entry[sev] += n
                totals[sev] += n
        for story, c in by_story_findings.items():
            print(
                f"  {story:<32} critical={c['Critical']} required={c['Required']} "
                f"nit={c['Nit']}  (across {c['passes']} review/QA pass(es))"
            )
        print(
            f"  {'project total':<32} critical={totals['Critical']} "
            f"required={totals['Required']} nit={totals['Nit']}"
        )

    if recovered_count:
        print()
        print(
            f"Note: {recovered_count} segment(s) were recovered from an interrupted "
            "run (killed terminal / restart) rather than a clean finish -- "
            "included in the totals above, flagged here for data-quality awareness."
        )

    return 0


if __name__ == "__main__":
    sys.exit(main())
