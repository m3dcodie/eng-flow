#!/usr/bin/env python3
"""
eng-flow analytics: per-step checkpoint.

Called at the start of every step in every eng-flow skill. Flushes the
previous step's segment (time + token usage since the last checkpoint) as
a durable row in eng-flow/analytics.jsonl, then opens a marker for the
step now starting. Logging happens incrementally, step by step, so a
killed terminal or system restart loses at most the current in-flight
step's data, not the whole skill run.

Usage: eng-flow-analytics-checkpoint <skill> <step-label> [story-slug]
"""
import importlib.machinery
import importlib.util
import json
import os
import sys
import time


def iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def load_usage():
    """eng-flow-usage, or None if it can't be loaded (rows go time-only)."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "eng-flow-usage")
    try:
        loader = importlib.machinery.SourceFileLoader("eng_flow_usage", path)
        spec = importlib.util.spec_from_loader("eng_flow_usage", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:  # analytics must never block the calling skill
        return None


def main():
    if len(sys.argv) < 3:
        print("usage: eng-flow-analytics-checkpoint <skill> <step-label> [story-slug]", file=sys.stderr)
        return 0  # never block the calling skill over a usage error
    skill, step = sys.argv[1], sys.argv[2]
    story = sys.argv[3] if len(sys.argv) > 3 else None

    root = os.getcwd()
    state_dir = os.path.join(root, "eng-flow", ".analytics-tmp")
    log_path = os.path.join(root, "eng-flow", "analytics.jsonl")
    marker_path = os.path.join(state_dir, f"{skill}.marker.json")

    try:
        os.makedirs(state_dir, exist_ok=True)
    except OSError:
        return 0  # degrade silently -- analytics must never block real work

    usage_lib = load_usage()
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    tpath = usage_lib.transcript_path(session) if usage_lib else None
    now_ts = time.time()
    now_line = usage_lib.line_count(tpath) if usage_lib else 0

    # Flush the previous segment, if a marker exists (from this run, or an
    # orphaned one left behind by a crash/restart -- either way it's real
    # unlogged work and worth recovering, not discarding).
    if os.path.isfile(marker_path):
        try:
            with open(marker_path) as f:
                marker = json.load(f)
        except (OSError, json.JSONDecodeError):
            marker = None
        if marker:
            outcome = "completed" if marker.get("session") == session else "recovered"
            usage, subagents = (
                usage_lib.segment_usage(marker.get("transcript"), marker.get("line", 0), now_line)
                if usage_lib
                else (None, None)
            )
            row = {
                "run_id": marker.get("run_id"),
                "skill": skill,
                "step": marker.get("step"),
                "story": marker.get("story"),
                "ts_start": iso(marker["ts"]),
                "ts_end": iso(now_ts),
                "duration_s": int(now_ts - marker["ts"]),
                "usage": usage,
                "outcome": outcome,
            }
            if usage_lib:
                usage_lib.apply_subagents(row, subagents)
            try:
                os.makedirs(os.path.dirname(log_path), exist_ok=True)
                with open(log_path, "a") as f:
                    f.write(json.dumps(row) + "\n")
            except OSError:
                pass
            run_id = marker.get("run_id")
        else:
            run_id = f"{skill}-{session or 'nosession'}-{int(now_ts)}"
    else:
        run_id = f"{skill}-{session or 'nosession'}-{int(now_ts)}"

    new_marker = {
        "run_id": run_id,
        "step": step,
        "story": story,
        "ts": now_ts,
        "line": now_line,
        "transcript": tpath,
        "session": session,
    }
    try:
        with open(marker_path, "w") as f:
            json.dump(new_marker, f)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
